// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../commons/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Model user
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials WebAuthnCredential[]
  vaults      Vault[]
  auditLogs   AuditLog[]
  sessions    Session[]

  @@map("users")
}

// Model webauthn credential
model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique @map("credential_id") @db.VarChar(255)
  publicKey    Bytes    @map("public_key")
  counter      BigInt   @default(0)
  transports   String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

// Model vault
//
// Un usuario puede tener varias bóvedas. Cada una tiene su propio salt,
// IV y blob cifrado: la master key nunca sale del cliente.
model Vault {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id")
  name          String   @db.VarChar(80)
  salt          Bytes
  iv            Bytes
  encryptedData Bytes    @map("encrypted_data")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("vaults")
}

// Model audit log
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  action    String   @db.VarChar(50)
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// Model session for access control
/**
 * Tabla de sesiones. **Ya no se usa**: las sesiones viven en Redis con un
 * token de 256 bits del que solo se persiste su hash SHA-256 (ver
 * `server/services/SessionService.ts`). Puede eliminarse con
 * `prisma migrate dev` en una siguiente pasada.
 */
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
