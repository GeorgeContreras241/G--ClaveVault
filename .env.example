# ── Base de datos ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/clavevault"

# ── URL pública del sitio (SEO, sitemap, canonical) ──────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── WebAuthn ─────────────────────────────────────────────────────────────
# rpID debe ser exactamente el hostname (sin protocolo ni puerto).
# ORIGIN es la URL completa desde la que se autentica el navegador.
RP_ID="localhost"
ORIGIN="http://localhost:3000"

# ── Redis (Upstash) ──────────────────────────────────────────────────────
# Requerido en producción: guarda retos WebAuthn, sesiones y rate limiting.
# En local, si se omiten, se usa un almacén en memoria.
# https://console.upstash.com/  →  crear base → copiar REST URL y REST Token
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
